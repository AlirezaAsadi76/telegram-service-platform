{
  "dashboard": {
    "id": null,
    "title": "SMM Bot Platform",
    "tags": ["smm", "bot", "go"],
    "timezone": "Asia/Tehran",
    "schemaVersion": 36,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Orders by Flow Type",
        "type": "stat",
        "targets": [{
          "expr": "sum by (flow_type) (smm_bot_orders_total)",
          "legendFormat": "{{flow_type}}"
        }],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Payment Success Rate",
        "type": "gauge",
        "targets": [{
          "expr": "sum(rate(smm_bot_payments_total{status=\"success\"}[5m])) / sum(rate(smm_bot_payments_total[5m]))",
          "legendFormat": "Success Rate"
        }],
        "fieldConfig": {
          "defaults": {
            "max": 1,
            "min": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.7},
                {"color": "green", "value": 0.95}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Active Orders",
        "type": "timeseries",
        "targets": [{
          "expr": "smm_bot_active_orders",
          "legendFormat": "{{status}}"
        }],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Worker Execution Time (p99)",
        "type": "timeseries",
        "targets": [{
          "expr": "histogram_quantile(0.99, sum by (job_name, le) (rate(smm_bot_worker_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job_name}}"
        }],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Wallet Transactions",
        "type": "stat",
        "targets": [{
          "expr": "sum by (type) (smm_bot_wallet_transactions_total)",
          "legendFormat": "{{type}}"
        }],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Notification Queue Depth",
        "type": "timeseries",
        "targets": [{
          "expr": "smm_bot_notification_queue_depth",
          "legendFormat": "Queue Depth"
        }],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}
      },
      {
        "id": 7,
        "title": "SMM Provider Latency (p95)",
        "type": "timeseries",
        "targets": [{
          "expr": "histogram_quantile(0.95, sum by (provider, le) (rate(smm_bot_smm_provider_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}}"
        }],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}
      }
    ]
  },
  "overwrite": true
}